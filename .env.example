# Copier ce fichier vers .env à la racine du projet et renseigner les valeurs.
# Ne pas commiter .env (mots de passe / webhooks).

# --- E-mail (SMTP) — exemple SendGrid ---
# SMTP_USER=apikey et SMTP_PASSWORD = clé API (Settings > API Keys)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=apikey
# Ne jamais mettre de vraie clé ici — uniquement dans .env (non versionné)
SMTP_PASSWORD=REMPLACEZ_PAR_CLE_API_SENDGRID
ALERT_EMAIL_FROM=votre_email_verifie_sendgrid@example.com
ALERT_EMAIL_TO=destinataire@example.com

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Optionnel : notification auto à l’ouverture de la page Alertes ---
# BVC_CRITICAL_ALERT_AUTO=true

